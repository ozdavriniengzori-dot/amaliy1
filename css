*{
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  font-family: Arial, sans-serif;
}

body{
  background: #f4f4f4;
}

nav{
  background: #222;
  padding: 15px 30px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.logo{
  color: white;
  font-size: 24px;
  font-weight: bold;
}

.menu{
  display: flex;
  gap: 20px;
  list-style: none;
}

.menu li a{
  color: white;
  text-decoration: none;
  font-size: 18px;
  transition: 0.3s;
}

.menu li a:hover{
  color: cyan;
}
